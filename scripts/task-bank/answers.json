            "content": "{\"a\": [\"prompt\"], \"b\": [\"hook\"], \"c\": [\"prompt\"]}"
          }
        ]
      }
    },
    "T-07": {
      "kind": "hook",
      "artefact": "hook/pretooluse.py",
      "block_exit": 2,
      "cases": [
        {
          "stdin": {
            "tool_name": "Bash",
            "tool_input": {
              "command": "rm -rf /tmp/x"
            }
          },
          "exit": 2,
          "stderr_nonempty": true
        },
        {
          "stdin": {
            "tool_name": "Bash",
            "tool_input": {
              "command": "echo hi && rm -rf build"
            }
          },
          "exit": 2,
          "stderr_nonempty": true
        },
        {
          "stdin": "{not json",
          "exit": 2,
          "stderr_nonempty": true
        },
        {
          "stdin": {
            "tool_name": "Bash",
            "tool_input": {
              "command": "ls"
            }
          },
          "exit": 0
        }
      ],
      "rubric": [
        "The settings entry binds the hook to the Bash matcher on PreToolUse."
      ],
      "dry_run": {
        "good": [
          {
            "write": "hook/pretooluse.py",
            "content": "import json, sys\ntry:\n    cmd = json.load(sys.stdin)['tool_input']['command']\nexcept Exception as e:\n    sys.stderr.write('hook error: %s' % e)\n    sys.exit(2)\nif 'rm -rf' in cmd:\n    sys.stderr.write('blocked: rm -rf')\n    sys.exit(2)\n"
          }
        ],
        "bad": [
          {
            "write": "hook/pretooluse.py",
            "content": "import json, sys\ntry:\n    cmd = json.load(sys.stdin)['tool_input']['command']\nexcept Exception:\n    sys.exit(0)\nif 'rm -rf' in cmd:\n    sys.stderr.write('blocked')\n    sys.exit(1)\n"
          }
        ]
      }
    },
    "T-08": {
      "kind": "commands",
      "requires": "docker",
      "new_files_only_under": "examples/repair-loop/typescript/tests/stack/",
      "forbid_regex": [
        "jest\\.mock"
      ],
      "require_regex": [
        "/users/undefined",
        "404",
        "User not found"
      ],
      "steps_note": "Dynamic check runs the new test against the base app (must fail) and with INC-001.fix.patch applied (must pass).",
      "commands": [
        {
          "cwd": "examples/repair-loop/typescript",
          "cmd": "npm run test:stack",
          "exit": "nonzero",
          "label": "base"
        },
        {
          "cwd": "examples/repair-loop/typescript",
          "apply_patch": "patches/INC-001.fix.patch",
          "cmd": "npm run test:stack",
          "exit": 0,
          "label": "fixed"
        }
      ],
      "rubric": []
    },
