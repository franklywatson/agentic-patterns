    "T-06": {
      "kind": "json",
      "artefact": "ANSWER.json",
      "expected": {
        "a": {
          "set": [
            "CI"
          ]
        },
        "b": {
          "set": [
            "sandbox",
            "downstream"
          ]
        },
        "c": {
          "set": [
            "CI"
          ]
        }
