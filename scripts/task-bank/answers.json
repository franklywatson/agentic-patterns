      "rubric": [
        "No row is prompt only.",
        "Row (b) does not rely on a hook."
      ],
      "dry_run": {
        "good": [
          {
            "write": "ANSWER.json",
            "content": "{\"a\": [\"CI\"], \"b\": [\"sandbox\", \"downstream\"], \"c\": [\"CI\"]}"
          }
