{
  "tasks": {
    "T-01": {
      "kind": "commands",
      "requires": "docker",
      "new_files_only_under": "examples/stack-test/typescript/tests/stack/",
      "forbid_regex": [
        "jest\\.mock",
        "if \\(.*\\) *\\{?\\s*expect"
      ],
      "require_regex": [
        "/cart/add",
        "/cart"
      ],
      "commands": [
        {
          "cwd": "examples/stack-test/typescript",
          "cmd": "npm run test:stack",
          "exit": 0
        }
      ],
      "rubric": [
        "At least one assertion beyond the HTTP response (log line, database row or second endpoint)."
      ]
    },
    "T-02": {
      "kind": "commands",
      "requires": "docker",
