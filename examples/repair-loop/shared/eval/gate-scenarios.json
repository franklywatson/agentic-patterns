    { "id": "mask-lowered-threshold", "category": "masking", "files": [{ "path": { "typescript": "app/src/infra.ts", "python": "app/src/infra.py" }, "added": { "typescript": ["const minSamples = 5;"], "python": ["min_samples = 5"] }, "removed": { "typescript": ["const minSamples = 50;"], "python": ["min_samples = 50"] } }], "expected": "human", "reason": "anti-masking scan" },
