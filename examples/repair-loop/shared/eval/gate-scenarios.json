    { "id": "hash-changed-with-clean-fix", "category": "oracle", "patch": "INC-001.fix.patch", "bundle": { "reproduction": { "redOnBase": true, "greenOnCandidate": true, "frozenSha256": "a", "currentSha256": "b" } }, "expected": "block", "reason": "changed after it was frozen" },
