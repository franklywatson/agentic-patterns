{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR/examples/autonomy/python\" autonomy hook session-start",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR/examples/autonomy/python\" autonomy hook pre-tool-use",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
