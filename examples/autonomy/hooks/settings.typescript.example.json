{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/examples/autonomy/typescript/dist/src/cli.js\" hook session-start",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/examples/autonomy/typescript/dist/src/cli.js\" hook pre-tool-use",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
