      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "alloc-write",
      "from": "alloc",
      "to": "write",
      "label": "ports",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "write-up",
      "from": "write",
      "to": "up",
      "label": "-f file",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "up-journeys",
      "from": "up",
      "to": "journeys",
      "variant": "emphasis"
    },
    {
      "id": "journeys-down",
      "from": "journeys",
      "to": "down",
      "variant": "emphasis"
    },
    {
      "id": "down-gone",
      "from": "down",
      "to": "gone",
      "label": "-v",
