    {
      "id": "alloc",
      "lane": "ports",
      "col": 1,
      "type": "backend",
      "label": "Allocate ports",
      "sublabel": "10000-65535, confirmed free"
    },
    {
      "id": "write",
      "lane": "file",
      "col": 1,
      "type": "backend",
      "label": "Write compose copy",
      "sublabel": "docker-compose-{test-name}-{pid}-{random}-{timestamp}.yml",
      "width": 230
    },
    {
      "id": "up",
      "lane": "project",
      "col": 2,
