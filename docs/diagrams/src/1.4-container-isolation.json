  "cards": [
    {
      "dot": "rose",
      "title": "Do not",
      "items": [
        "Set a fixed container_name: Compose cannot prefix it",
        "Hardcode ports such as 3000, 5432, 6379",
        "Share volumes between runs",
        "Publish test ports on all interfaces"
      ]
    },
    {
      "dot": "amber",
      "title": "Docker resource exhaustion",
      "items": [
        "Each project uses at least one network",
        "Subnets come from a finite default address pool",
        "down -v --remove-orphans and docker network prune keep runs under it"
      ]
    }
  ]
