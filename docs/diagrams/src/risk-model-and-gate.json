 "cards": [
  {
   "dot": "cyan",
   "title": "Risk model (Pattern 1.8)",
   "items": [
    "Reversibility R0 inert to R4 external or irreversible; blast radius B0 one journey to B3 money, auth, PII or audit",
    "The classifier reads the diff and fails closed: an unclassified change is R4 at B3, high tier"
   ]
  },
  {
   "dot": "amber",
   "title": "Gate rules (Pattern 1.11)",
   "items": [
    "Most severe finding wins: block over human over auto",
    "A1 and A2: the gate returns at most human; A3 and up: auto up to R2 at B1",
    "R3, R4, B2 and B3 always get human; unattended repair of R3 and R4 is not supported at any grant"
   ]
  },
  {
   "dot": "emerald",
   "title": "Who merges an auto result",
   "items": [
    "Below A4 a person always merges",
    "A4 and A5: R0 and R1 at B0 merge with no person; A5 adds R2 at B0 on named paths",
    "Only auto changes reach production, through a canary with automatic rollback"
   ]
  }
 ]
}