  "cards": [
    {
      "dot": "cyan",
      "title": "Keep a step down only if it passes",
      "items": [
        "Run the task bank at the candidate setting and one step up, k of at least 3 each",
        "Keep the cheaper setting only if it passes every task the stronger one passes",
        "Judge a setting by cost per merged change, not tokens per session"
      ]
    },
    {
      "dot": "amber",
      "title": "Where the setting holds",
      "items": [
        "Model and effort in each subagent definition and unattended command; a table in the instruction file is guidance only",
        "Managed settings restrict models and cap effort; --max-budget-usd and --max-turns bound an unattended run",
        "A mid-session model switch re-reads the conversation uncached; send other-model work to a subagent"
      ]
    }
